---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import TeamCard from '../../components/TeamCard.astro';
import AreaCard from '../../components/AreaCard.astro';
import DeadlineCalc from '../../components/DeadlineCalc.astro';
import { team } from '../../data/office';
import { langs, path, t, type Lang } from '../../i18n/ui';
import { c } from '../../i18n/content';
import { areaLinks } from '../../lib/areas';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const s = t(lang);
const k = c(lang);
const links = await areaLinks(lang);
---

<Base lang={lang}>
  <Hero lang={lang} />

  <section class="section">
    <div class="wrap">
      <div class="split">
        <h2 class="section-title">{s.intro.title}</h2>
        <p class="intro__lead">{s.intro.lead}</p>
      </div>
      <ul class="points">
        {
          s.intro.points.map((pt) => (
            <li>
              <h3>{pt.title}</h3>
              <p>{pt.text}</p>
            </li>
          ))
        }
      </ul>
      <a class="text-link" href={`${path(lang, 'mediation')}#surec`}>{k.mediation.processTitle}</a>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap">
      <div class="split">
        <h2 class="section-title">{k.home.practiceTitle}</h2>
        <p class="practice-lead">{k.home.practiceLead}</p>
      </div>
      <ul class="areas">
        {
          k.practice.areas.slice(0, 8).map((area) => (
            <AreaCard id={area.id} title={area.title} items={area.items} href={links[area.id]} dark />
          ))
        }
      </ul>
      <a class="text-link text-link--light" href={path(lang, 'practice')}>{k.home.practiceLink}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <DeadlineCalc lang={lang} />
      <a class="text-link" href={path(lang, 'resources')}>{k.resources.petitionsTitle}</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">{k.home.teamTitle}</h2>
      <div class="team">
        {team.map((lawyer) => <TeamCard lawyer={lawyer} lang={lang} compact />)}
      </div>
      <a class="text-link" href={path(lang, 'about')}>{k.home.teamLink}</a>
    </div>
  </section>

  <section class="section contact-band">
    <div class="wrap split">
      <h2 class="section-title">{k.home.contactTitle}</h2>
      <div>
        <p>{k.home.contactLead}</p>
        <a class="btn btn--solid" href={path(lang, 'contact')}>{s.cta}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro__lead {
    max-width: 36rem;
    padding-top: 1.75rem;
    border-top: 2px solid var(--gold);
    font-size: var(--step-1);
    font-weight: 330;
    color: var(--ink-muted);
  }

  .points {
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .points li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.6rem 1.5rem 1.75rem;
    background: #f7f7f4;
    border: 1px solid var(--limestone-200);
    border-top: 2px solid var(--gold);
  }

  .points h3 {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .points p {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Rusça başlıklar uzun; kart kenarına taşmasın */
  :lang(ru) .points h3 {
    font-size: 1.5rem;
    overflow-wrap: break-word;
  }

  .practice-lead {
    max-width: 36rem;
    font-size: var(--step-1);
    font-weight: 330;
  }

  .areas {
    margin: clamp(2rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.75rem 1.5rem;
  }

  .text-link--light {
    color: var(--silver);
  }

  .text-link--light:hover {
    color: #fff;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2.5rem;
  }

  @media (max-width: 40rem) {
    .team {
      gap: 1.25rem;
    }
  }

  /* Kendi zemini olduğu için üst boşluğu korunur */
  .section.contact-band {
    background: var(--limestone-200);
    padding-top: var(--section-y);
  }

  .contact-band p {
    max-width: 34rem;
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }

  @media (max-width: 64rem) {
    .areas,
    .points {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .areas {
      gap: 1.75rem 0.75rem;
    }

    .points {
      gap: 0.625rem;
    }

    .points li {
      padding: 1.1rem 1rem 1.25rem;
    }

    .points h3 {
      font-size: 1.1875rem;
    }

    :lang(ru) .points h3 {
      font-size: 1rem;
    }

  }
</style>
