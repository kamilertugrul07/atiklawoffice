---
// Alt sayfaların detayları: makaleler (/tr/makaleler/<makale>/), avukatlar (/tr/hakkimizda/<avukat>/)
// faaliyet alanları (/tr/faaliyet-alanlari/<alan>/) ve dilekçe örnekleri (/tr/dilekceler/<dilekçe>/)
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import LawyerPage from '../../../components/pages/LawyerPage.astro';
import AreaPage from '../../../components/pages/AreaPage.astro';
import PetitionPage from '../../../components/pages/PetitionPage.astro';
import { team, type Lawyer } from '../../../data/office';
import { langs, routes, t, type Lang } from '../../../i18n/ui';
import { c } from '../../../i18n/content';
import { articleLang, articleSlug, formatDate, type Article } from '../../../lib/articles';
import { areaEntryLang, areaEntrySlug, areaHref, type AreaEntry } from '../../../lib/areas';
import { petitionHref, petitionInfo, type Petition } from '../../../lib/petitions';
import { pageImage } from '../../../lib/images';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  const href = (e: Article) => {
    const l = articleLang(e);
    return `/${l}/${routes.articles[l]}/${articleSlug(e)}/`;
  };
  const articlePaths = all.map((entry) => {
    const lang = articleLang(entry);
    // Aynı makalenin diğer dillerdeki sürümleri; olmayan dilde makaleler listesine gidilir
    const alternates = Object.fromEntries(
      all.filter((e) => e.data.key === entry.data.key).map((e) => [articleLang(e), href(e)]),
    );
    return {
      params: { lang, section: routes.articles[lang], slug: articleSlug(entry) },
      props: { entry, alternates },
    };
  });

  const lawyerPaths = langs.flatMap((lang) =>
    team.map((lawyer) => ({
      params: { lang, section: routes.about[lang], slug: lawyer.slug },
      props: {
        lawyer,
        alternates: Object.fromEntries(langs.map((l) => [l, `/${l}/${routes.about[l]}/${lawyer.slug}/`])),
      },
    })),
  );

  // Aynı alanın diğer dillerdeki sayfası; henüz yazılmamışsa o dilin faaliyet alanları sayfası
  const areas = await getCollection('areas');
  const areaPaths = areas.map((entry) => {
    const lang = areaEntryLang(entry);
    const alternates = Object.fromEntries(
      areas.filter((e) => e.data.key === entry.data.key).map((e) => [areaEntryLang(e), areaHref(e)]),
    );
    return {
      params: { lang, section: routes.practice[lang], slug: areaEntrySlug(entry) },
      props: { area: entry, alternates },
    };
  });

  // Dilekçeler her dilde aynı adresle yayımlanır; metin Türkçe, açıklamalar o dilde
  const petitions = await getCollection('petitions');
  const petitionPaths = langs.flatMap((lang) =>
    petitions.map((entry) => ({
      params: { lang, section: routes.resources[lang], slug: entry.id },
      props: {
        petition: entry,
        alternates: Object.fromEntries(langs.map((l) => [l, petitionHref(entry, l)])),
      },
    })),
  );

  return [...articlePaths, ...lawyerPaths, ...areaPaths, ...petitionPaths];
}

type Props = { alternates: Partial<Record<Lang, string>> } & (
  | { entry: Article }
  | { lawyer: Lawyer }
  | { area: AreaEntry }
  | { petition: Petition }
);
const props = Astro.props as Props;
const { alternates } = props;
const lang = Astro.params.lang as Lang;
const a = c(lang).articles;
const entry = 'entry' in props ? props.entry : undefined;
const lawyer = 'lawyer' in props ? props.lawyer : undefined;
const area = 'area' in props ? props.area : undefined;
const areaInfo = area && c(lang).practice.areas.find((x) => x.id === area.data.key);
const petition = 'petition' in props ? props.petition : undefined;
const petitionText = petition && petitionInfo(petition, lang);
const Content = entry ? (await render(entry)).Content : undefined;
const lawyerName = lawyer && `${lawyer.isMediator ? 'Av. Arb.' : 'Av.'} ${lawyer.name}`;
---

{
  petition && petitionText && (
    <Base
      lang={lang}
      routeKey="resources"
      alternates={alternates}
      title={`${petitionText.title} | ${t(lang).firmName}`}
      description={petitionText.summary}
    >
      <PetitionPage lang={lang} entry={petition} />
    </Base>
  )
}

{
  area && areaInfo && (
    <Base
      lang={lang}
      routeKey="practice"
      alternates={alternates}
      title={`${areaInfo.title} | ${t(lang).firmName}`}
      description={areaInfo.summary}
    >
      <AreaPage lang={lang} entry={area} />
    </Base>
  )
}

{
  lawyer && (
    <Base
      lang={lang}
      routeKey="about"
      alternates={alternates}
      title={`${lawyerName} | ${t(lang).firmName}`}
      description={`${lawyerName}, ${lawyer.title[lang]}. ${t(lang).firmName}.`}
    >
      <LawyerPage lang={lang} lawyer={lawyer} />
    </Base>
  )
}

{entry && Content && (
<Base
  lang={lang}
  routeKey="articles"
  alternates={alternates}
  title={`${entry.data.title} | ${t(lang).firmName}`}
  description={entry.data.description}
>
  <PageHead title={entry.data.title} image={pageImage('articles')}>
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
  </PageHead>

  <article class="section">
    <div class="wrap">
      <div class="prose">
        <p class="lead">{entry.data.description}</p>
        <Content />
        <p class="note">{a.note}</p>
        <a class="text-link" href={`/${lang}/${routes.articles[lang]}/`}>{a.back}</a>
      </div>
    </div>
  </article>
</Base>
)}

<style>
  time {
    display: block;
    margin-top: 1.5rem;
    color: var(--silver-muted);
    font-size: var(--step--1);
  }

  .prose {
    max-width: 42rem;
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .lead {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.35;
    margin-bottom: 2.5rem;
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
  }

  .prose :global(p + p) {
    margin-top: 1rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
    margin: 1rem 0;
  }

  .prose :global(li::marker) {
    color: var(--gold);
  }

  .prose :global(strong) {
    font-weight: 550;
  }

  .note {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--limestone-200);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
</style>
