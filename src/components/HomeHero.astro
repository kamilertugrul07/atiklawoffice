---
// Ana sayfa açılışı, "Sahne": koyu zeminde iki altın çizgi birleşip logoyu kurar (eski açılıştaki animasyon);
// kaydırmaya devam edince logo yukarı doğru çekilir, arkadan ofis fotoğrafı ve başlık belirir.
// Bilgisayarda kaydırmayla, telefonda kendiliğinden oynar; hareket azaltma tercihinde doğrudan son hâl gösterilir.
import { Image } from 'astro:assets';
import { path, t, type Lang } from '../i18n/ui';
import { c } from '../i18n/content';
import { office } from '../data/office';
import { logoA, logoRing, logoRingWidth, logoRule, logoSubtitle, logoTik } from '../data/logo';
import photo from '../assets/img/home/hero.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const h = c(lang).home;

// Logodaki A'nın tepe noktası ve bacak dipleri (src/data/logo.ts ile aynı koordinatlar)
const apex = { x: 251, y: 93 };
const feet = { left: 133, right: 372, y: 351 };
// Altın çizgi: logodakinden kalın, ortadan iki yana uzar
const rule = { y: logoRule.y - 2, height: 7, x: logoRule.x, width: logoRule.width };
const ruleCenter = rule.x + rule.width / 2;
// "TİK" soldan sağa açılan maskeyle belirir
const tikBox = { x: 455, y: 170, width: 640, height: 195 };
---

<section class="hh" data-hh>
  <!-- JS çalışmazsa sahne son hâliyle görünür; çalışıyorsa ilk kare hemen hazırlanır -->
  <script is:inline>
    document.currentScript.parentElement.classList.add('is-staged');
  </script>

  <Image
    class="hh__photo"
    src={photo}
    alt=""
    widths={[800, 1400, 2000, 2688]}
    sizes="100vw"
    quality={72}
    loading="eager"
    data-hh-photo
  />
  <div class="hh__shade" data-hh-shade></div>

  <div class="hh__stage" aria-hidden="true">
    <svg class="converge" viewBox="70 40 1030 490" data-hh-logo>
      <defs>
        <clipPath id="hh-tik-reveal">
          <rect x={tikBox.x} y={tikBox.y} width="0" height={tikBox.height} data-tik-clip></rect>
        </clipPath>
      </defs>

      <path class="converge__ring" d={logoRing} stroke-width={logoRingWidth} pathLength="1" data-ring></path>
      <path class="converge__fill" d={logoA} data-a></path>

      <!-- Açılış animasyonu <g> üzerinde, kaydırma animasyonu <line> üzerinde: birbirine karışmazlar -->
      <g data-intro>
        <line class="converge__line converge__line--a" x1={feet.left} y1={feet.y} x2={feet.left} y2={apex.y} data-line-a></line>
      </g>
      <g data-intro>
        <line class="converge__line converge__line--b" x1={feet.right} y1={feet.y} x2={feet.right} y2={apex.y} data-line-b></line>
      </g>

      <rect class="converge__rule" x={ruleCenter} y={rule.y} width="0" height={rule.height} data-rule></rect>
      <path class="converge__fill" d={logoTik} clip-path="url(#hh-tik-reveal)"></path>
      <!-- Alt yazı (HUKUK & ARABULUCULUK) logo kurulduktan sonra belirir -->
      <path class="converge__fill converge__sub" d={logoSubtitle[lang]} data-subtitle></path>
    </svg>
  </div>

  <div class="wrap hh__inner">
    <p class="kicker" data-hh-text>{h.kicker}</p>
    <h1 data-hh-text>{s.hero.title}</h1>
    <p class="hh__lead" data-hh-text>{s.hero.lead}</p>
    <div class="hh__actions" data-hh-text>
      <a class="btn btn--solid" href={path(lang, 'contact')}>{s.cta}</a>
      <a class="btn btn--ghost" href={path(lang, 'practice')}>{s.hero.secondary}</a>
      <a class="btn btn--ghost btn--directions" href={office.directionsLink} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s-6.5-6.1-6.5-11a6.5 6.5 0 0 1 13 0c0 4.9-6.5 11-6.5 11Z"></path>
          <circle cx="12" cy="10" r="2.3"></circle>
        </svg>
        {s.hero.directions}
      </a>
    </div>
  </div>
</section>

<style>
  .hh {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 55% at 50% 48%, var(--petrol-700) 0%, transparent 70%),
      var(--petrol-900);
    color: var(--silver);
  }

  .hh__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  .hh__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(12 35 39 / 0.94) 0%, rgb(12 35 39 / 0.55) 45%, rgb(12 35 39 / 0) 75%),
      linear-gradient(180deg, rgb(12 35 39 / 0.75) 0%, rgb(12 35 39 / 0) 30%, rgb(12 35 39 / 0) 70%, rgb(12 35 39 / 0.6) 100%);
  }

  /* Logo sahnenin ortasında; son hâlde görünmez */
  .hh__stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: var(--header-h) var(--gutter) 0;
    pointer-events: none;
  }

  .converge {
    width: min(46rem, 72vw);
    overflow: visible;
    opacity: 0;
  }

  .converge__line {
    stroke: var(--gold);
    stroke-linecap: square;
  }

  .converge__line--a {
    stroke-width: 4;
  }

  .converge__line--b {
    stroke-width: 7;
  }

  .converge__ring {
    fill: none;
    stroke: var(--gold);
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .converge__fill {
    fill: #eceeee;
  }

  [data-a],
  .converge__sub {
    opacity: 0;
  }

  .converge__rule {
    fill: var(--gold-soft);
  }

  /* İlk kare: fotoğraf ve yazılar gizli, logo görünür (betik çalışınca devralır) */
  .hh.is-staged .hh__photo,
  .hh.is-staged .hh__shade,
  .hh.is-staged [data-hh-text] {
    opacity: 0;
  }

  .hh.is-staged .converge {
    opacity: 1;
  }

  /* Menüdeki logo sahne bitince belirir */
  :global(body:has(.hh.is-staged) .site-header .brand) {
    opacity: 0;
  }

  .hh__inner {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3rem, 9vh, 6rem);
  }

  .kicker {
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  /* Başlık metindeki satır sonundan iki satıra bölünür */
  h1 {
    margin-top: 1.25rem;
    white-space: pre-line;
    font-size: clamp(2.125rem, 5vw, 4.5rem);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: #f3f3f2;
  }

  :global(html:is([lang='en'], [lang='ru'])) h1 {
    font-size: clamp(1.875rem, 4.2vw, 3.875rem);
  }

  .hh__lead {
    max-width: 36rem;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--gold);
    font-size: var(--step-1);
    line-height: 1.55;
    font-weight: 330;
  }

  .hh__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .btn--directions {
    gap: 0.55rem;
  }

  .btn--directions svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.5;
  }

  @media (max-width: 40rem) {
    .hh {
      min-height: 78svh;
    }

    .hh__shade {
      background: linear-gradient(180deg, rgb(12 35 39 / 0.78) 0%, rgb(12 35 39 / 0.45) 40%, rgb(12 35 39 / 0.92) 100%);
    }

    .converge {
      width: 82vw;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const hero = document.querySelector<HTMLElement>('[data-hh]')!;
  const logo = hero.querySelector('[data-hh-logo]');
  const lines = hero.querySelectorAll('[data-line-a], [data-line-b]');
  const ring = hero.querySelector('[data-ring]');
  const fillA = hero.querySelector('[data-a]');
  const rule = hero.querySelector('[data-rule]');
  const tikClip = hero.querySelector('[data-tik-clip]');
  const subtitle = hero.querySelector('[data-subtitle]');
  const photo = hero.querySelector('[data-hh-photo]');
  const shade = hero.querySelector('[data-hh-shade]');
  const texts = hero.querySelectorAll('[data-hh-text]');
  const brand = document.querySelector('.site-header .brand');
  const apex = { x2: 251, y2: 93 };
  const ruleFull = { x: 82, width: 996 };

  // Son hâl: fotoğraf, başlık ve menü logosu görünür; sahnedeki logo gizli
  function showFinal() {
    hero.classList.remove('is-staged');
    gsap.set(logo, { opacity: 0 });
  }

  // Betik ilk kareyi devralır; sınıf kalkınca CSS'teki gizleme biter, değerler GSAP'te kalır
  function stage() {
    gsap.set([photo, shade, texts], { opacity: 0 });
    gsap.set(photo, { scale: 1.08 });
    gsap.set(brand, { opacity: 0 });
    gsap.set(logo, { opacity: 1 });
    hero.classList.remove('is-staged');
  }

  function buildTimeline(vars: gsap.TimelineVars) {
    return (
      gsap
        .timeline(vars)
        // 1. İki çizgi birleşir, logo kurulur
        .to(lines, { attr: apex, ease: 'power2.inOut', duration: 1 })
        .to(ring, { strokeDashoffset: 0, ease: 'none', duration: 0.8 }, '-=0.15')
        .to(fillA, { opacity: 1, duration: 0.45 }, '-=0.35')
        .to(lines, { opacity: 0, duration: 0.45 }, '<')
        .to(rule, { attr: ruleFull, ease: 'power2.out', duration: 0.7 }, '-=0.1')
        .to(tikClip, { attr: { width: 640 }, ease: 'power1.inOut', duration: 0.9 }, '-=0.35')
        .fromTo(subtitle, { opacity: 0, y: 14 }, { opacity: 1, y: 0, ease: 'power2.out', duration: 0.6 }, '-=0.2')
        // Logo bir an tam hâliyle durur
        .to({}, { duration: 0.5 })
        // 2. Logo yukarı çekilir, fotoğraf ve başlık belirir
        .to(logo, { opacity: 0, scale: 0.55, yPercent: -55, ease: 'power2.in', duration: 0.9 })
        .to(photo, { opacity: 1, scale: 1, ease: 'power1.out', duration: 1.4 }, '-=0.6')
        .to(shade, { opacity: 1, duration: 1 }, '<')
        .fromTo(texts, { opacity: 0, y: 28 }, { opacity: 1, y: 0, stagger: 0.18, ease: 'power2.out', duration: 0.8 }, '-=0.7')
        .to(brand, { opacity: 1, duration: 0.6 }, '-=0.4')
    );
  }

  function intro() {
    // Açılış: iki çizgi aşağıdan yukarı uzar
    return gsap.from('[data-intro]', {
      scaleY: 0,
      svgOrigin: '250 351',
      duration: 1.4,
      ease: 'power3.out',
      stagger: 0.15,
    });
  }

  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: reduce)', showFinal);

  // Geniş ekran: ilk ekran sabitlenir, sahne kaydırmayla oynar
  mm.add('(min-width: 60.01rem) and (prefers-reduced-motion: no-preference)', () => {
    stage();
    intro();
    buildTimeline({
      scrollTrigger: { trigger: hero, start: 'top top', end: '+=200%', scrub: 0.8, pin: true },
    });
  });

  // Telefon ve tablet: sabitleme yok, sahne açılıştan sonra kendiliğinden oynar
  mm.add('(max-width: 60rem) and (prefers-reduced-motion: no-preference)', () => {
    stage();
    intro();
    // Telefonda içerik beklemesin diye sahne daha hızlı oynar
    buildTimeline({ delay: 1 }).timeScale(1.7);
  });
</script>
