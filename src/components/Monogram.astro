---
// Fotoğraf gelene kadar baş harflerden, altın halkalı monogram
interface Props {
  name: string;
  size?: 'sm' | 'md';
}
const { name, size = 'md' } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<div class:list={['monogram', `monogram--${size}`]} aria-hidden="true">
  <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="47"></circle></svg>
  <span>{initials}</span>
</div>

<style>
  .monogram {
    position: relative;
    flex: none;
    width: 6.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .monogram--sm {
    width: 4.5rem;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  circle {
    fill: var(--petrol-800);
    stroke: var(--gold);
    stroke-width: 1.5;
  }

  span {
    position: relative;
    font-family: var(--font-serif);
    font-size: 2.1rem;
    letter-spacing: 0.04em;
    color: var(--silver);
  }

  .monogram--sm span {
    font-size: 1.5rem;
  }
</style>
