---
// Fotoğraf gelene kadar baş harflerden, altın çerçeveli kare monogram
interface Props {
  name: string;
  size?: 'sm' | 'md';
}
const { name, size = 'md' } = Astro.props;
const initials = name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<div class:list={['monogram', `monogram--${size}`]} aria-hidden="true">
  <span>{initials}</span>
</div>

<style>
  .monogram {
    position: relative;
    flex: none;
    width: 6.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: var(--petrol-800);
    border: 1px solid var(--gold);
  }

  .monogram--sm {
    width: 4.5rem;
  }

  span {
    position: relative;
    font-family: var(--font-serif);
    font-size: 2.1rem;
    letter-spacing: 0.04em;
    color: var(--silver);
  }

  .monogram--sm span {
    font-size: 1.5rem;
  }
</style>
