---
import PageHead from '../PageHead.astro';
import { routes, type Lang } from '../../i18n/ui';
import { c } from '../../i18n/content';
import { articleSlug, articlesFor, formatDate } from '../../lib/articles';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = c(lang).articles;
const list = await articlesFor(lang);
---

<PageHead title={a.title} lead={a.lead} />

<section class="section">
  <div class="wrap">
    {list.length === 0 && <p class="empty">{a.empty}</p>}
    <ul class="list">
      {
        list.map((entry) => (
          <li>
            <a href={`/${lang}/${routes.articles[lang]}/${articleSlug(entry)}/`}>
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
              <h2>{entry.data.title}</h2>
              <p>{entry.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--limestone-200);
  }

  li {
    border-bottom: 1px solid var(--limestone-200);
  }

  a {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 0.5rem 3rem;
    padding-block: 2rem;
    text-decoration: none;
  }

  time {
    grid-row: span 2;
    font-size: var(--step--1);
    color: var(--ink-muted);
    padding-top: 0.4rem;
  }

  h2 {
    font-size: var(--step-2);
    transition: color 0.2s;
  }

  a:hover h2 {
    color: var(--petrol-700);
  }

  p {
    max-width: 44rem;
    color: var(--ink-muted);
  }

  .empty {
    color: var(--ink-muted);
  }

  @media (max-width: 44rem) {
    a {
      grid-template-columns: 1fr;
    }

    time {
      grid-row: auto;
    }
  }
</style>
