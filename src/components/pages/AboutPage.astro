---
import PageHead from '../PageHead.astro';
import Sheet from '../Sheet.astro';
import Monogram from '../Monogram.astro';
import { team } from '../../data/office';
import { path, t, type Lang } from '../../i18n/ui';
import { areaTitle, c } from '../../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const a = c(lang).about;
const slug = (name: string) =>
  name
    .toLocaleLowerCase('tr')
    .normalize('NFD')
    .replace(/[^a-z\s]/g, '')
    .trim()
    .replace(/\s+/g, '-');
const honorific = (isMediator: boolean) => (isMediator ? 'Av. Arb.' : 'Av.');
---

<PageHead title={a.title} lead={a.lead} />

<section class="section">
  <div class="wrap split">
    <h2 class="section-title">{a.firmTitle}</h2>
    <div class="firm">
      {a.firm.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="section-title">{a.principlesTitle}</h2>
    <div class="principles">
      {
        a.principles.map((pr) => (
          <div>
            <h3>{pr.title}</h3>
            <p>{pr.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="wrap">
    <h2 class="section-title">{a.lawyersTitle}</h2>
    <ul class="tiles lawyers">
      {
        team.map((lawyer) => (
          <li>
            <button class="tile" type="button" data-open={`lawyer-${slug(lawyer.name)}`} aria-haspopup="dialog">
              <Monogram name={lawyer.name} size="sm" />
              <h3>
                {honorific(lawyer.isMediator)} {lawyer.name}
              </h3>
              <p>{lawyer.title[lang]}</p>
              <span class="tile__more">{a.more}</span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>

{
  team.map((lawyer) => (
    <Sheet
      id={`lawyer-${slug(lawyer.name)}`}
      title={`${honorific(lawyer.isMediator)} ${lawyer.name}`}
      subtitle={lawyer.title[lang]}
      closeLabel={a.close}
    >
      {lawyer.bio[lang] && (
        <>
          <h3 class="sheet__label">{a.cvTitle}</h3>
          <p class="sheet__lead">{lawyer.bio[lang]}</p>
        </>
      )}
      {lawyer.areas.length > 0 && (
        <>
          <h3 class="sheet__label">{a.areasTitle}</h3>
          <ul class="sheet__list">
            {lawyer.areas.map((id) => (
              <li>{areaTitle(lang, id)}</li>
            ))}
          </ul>
        </>
      )}
      <dl class="sheet__facts lawyer-facts">
        <div>
          <dt>{a.education}</dt>
          <dd>{lawyer.university}</dd>
        </div>
        <div>
          <dt>{a.bar}</dt>
          <dd>{s.footer.bar}</dd>
        </div>
        {lawyer.email && (
          <div>
            <dt>{a.email}</dt>
            <dd>
              <a href={`mailto:${lawyer.email}`}>{lawyer.email}</a>
            </dd>
          </div>
        )}
        <div>
          <dt>{a.phone}</dt>
          <dd>{lawyer.phone}</dd>
        </div>
      </dl>
      <a class="btn btn--solid sheet__cta" href={`${path(lang, 'contact')}?avukat=${encodeURIComponent(lawyer.name)}`}>
        {s.cta}
      </a>
    </Sheet>
  ))
}

<style>
  .firm {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    padding-top: 1.75rem;
    border-top: 2px solid var(--gold);
    color: var(--ink-muted);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .principles div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--gold);
  }

  .principles h3 {
    font-size: var(--step-2);
    margin-bottom: 0.5rem;
  }

  .principles p {
    color: var(--ink-muted);
  }

  .lawyers .tile {
    min-height: 0;
    gap: 1rem;
  }

  .lawyer-facts {
    margin-top: 2rem;
  }

  .sheet__cta {
    margin-top: 2rem;
  }

  @media (max-width: 50rem) {
    .principles {
      grid-template-columns: 1fr;
    }
  }
</style>
