---
import PageHead from '../PageHead.astro';
import Monogram from '../Monogram.astro';
import { team } from '../../data/office';
import { path, type Lang } from '../../i18n/ui';
import { c } from '../../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = c(lang).about;
const honorific = (isMediator: boolean) => (isMediator ? 'Av. Arb.' : 'Av.');
---

<PageHead title={a.title} lead={a.lead} />

<section class="section">
  <div class="wrap split">
    <h2 class="section-title">{a.firmTitle}</h2>
    <div class="firm">
      {a.firm.map((para) => <p>{para}</p>)}
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="wrap">
    <h2 class="section-title">{a.lawyersTitle}</h2>
    <ul class="tiles lawyers">
      {
        team.map((lawyer) => (
          <li>
            <a class="tile" href={`${path(lang, 'about')}${lawyer.slug}/`}>
              <Monogram name={lawyer.name} size="sm" />
              <h3>
                {honorific(lawyer.isMediator)} {lawyer.name}
              </h3>
              <p>{lawyer.title[lang]}</p>
              <span class="tile__more">{a.more}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="section-title">{a.principlesTitle}</h2>
    <div class="principles">
      {
        a.principles.map((pr) => (
          <div>
            <h3>{pr.title}</h3>
            <p>{pr.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .firm {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
    padding-top: 1.75rem;
    border-top: 2px solid var(--gold);
    color: var(--ink-muted);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .principles div {
    padding-top: 1.25rem;
    border-top: 1px solid var(--gold);
  }

  .principles h3 {
    font-size: var(--step-2);
    margin-bottom: 0.5rem;
  }

  .principles p {
    color: var(--ink-muted);
  }

  @media (max-width: 40rem) {
    .firm {
      font-size: var(--step-0);
      padding-top: 1.25rem;
    }

    .principles {
      gap: 1.5rem;
    }
  }

  .lawyers .tile {
    min-height: 0;
    gap: 1rem;
  }

  /* Telefonda kutu tek satır: harf simgesi solda, ad ve unvan sağda */
  @media (max-width: 40rem) {
    .lawyers .tile {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      row-gap: 0.15rem;
      align-items: center;
      padding: 1rem;
    }

    .lawyers .tile > :global(.monogram) {
      grid-row: span 3;
    }

    .lawyers .tile .tile__more {
      padding-top: 0.35rem;
    }
  }

  @media (max-width: 50rem) {
    .principles {
      grid-template-columns: 1fr;
    }
  }
</style>
