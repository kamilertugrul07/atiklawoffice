---
import PageHead from '../PageHead.astro';
import TeamCard from '../TeamCard.astro';
import { team } from '../../data/office';
import { path, t, type Lang } from '../../i18n/ui';
import { c } from '../../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const m = c(lang).mediation;
const mediator = team.find((p) => p.isMediator)!;
---

<PageHead title={m.title} lead={m.lead} />

<!-- Başlıklar görünür, içerik tıklayınca açılır; sayfa kısa kalır -->
<section class="section">
  <div class="wrap">
    <div class="folds">
      <details class="fold" id="neden">
        <summary><h2>{m.whyTitle}</h2></summary>
        <div class="fold__body grid-2">
          {
            m.why.map((w) => (
              <div>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
              </div>
            ))
          }
        </div>
      </details>

      <details class="fold" id="ihtiyari">
        <summary><h2>{m.voluntaryTitle}</h2></summary>
        <div class="fold__body">
          <p class="voluntary-lead">{m.voluntaryLead}</p>
          <div class="voluntary">
            {
              m.voluntary.map((v) => (
                <article>
                  <h3>{v.title}</h3>
                  <p>{v.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </details>

      <details class="fold" id="kapsam">
        <summary><h2>{m.scopeTitle}</h2></summary>
        <div class="fold__body">
          <ul class="scope">
            {m.scope.map((item) => <li>{item}</li>)}
          </ul>
          <p class="scope-note">{m.scopeNote}</p>
        </div>
      </details>

      <details class="fold" id="surec">
        <summary><h2>{m.processTitle}</h2></summary>
        <div class="fold__body">
          <ol class="process">
            {
              m.process.map((step) => (
                <li>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </details>

      <details class="fold" id="zorunlu">
        <summary><h2>{m.mandatoryTitle}</h2></summary>
        <div class="fold__body">
          <p class="mandatory-lead">{m.mandatoryLead}</p>
          <table class="mandatory">
            <tbody>
              {
                m.mandatory.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.title}
                      <span>{row.basis}</span>
                    </th>
                    <td>
                      <span class="visually-label">{m.durationLabel}</span>
                      {row.duration}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </div>
</section>

<section class="section mediator-band">
  <div class="wrap split mediator">
    <div>
      <h2 class="section-title">{m.mediatorTitle}</h2>
      <p class="note">{m.mediatorNote}</p>
    </div>
    <div class="mediator__card">
      <TeamCard lawyer={mediator} lang={lang} />
      <a class="btn btn--solid cta" href={path(lang, 'contact')}>{s.cta}</a>
    </div>
  </div>
</section>

<style>
  .folds {
    max-width: 62rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .fold {
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .fold summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: clamp(1.1rem, 2.5vw, 1.75rem);
    cursor: pointer;
    list-style: none;
  }

  .fold summary::-webkit-details-marker {
    display: none;
  }

  .fold summary h2 {
    font-size: var(--step-3);
    font-weight: 450;
  }

  /* Artı işareti açılınca çarpıya döner */
  .fold summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold);
    font-size: 1.25rem;
    line-height: 1;
    transition:
      transform 0.25s,
      background-color 0.25s,
      color 0.25s;
  }

  .fold[open] summary::after {
    transform: rotate(45deg);
    background: var(--gold);
    color: #fff;
  }

  .fold summary:hover h2 {
    color: var(--petrol-700);
  }

  .fold__body {
    padding-bottom: clamp(1.75rem, 4vw, 3rem);
  }

  @media (max-width: 40rem) {
    .fold summary h2 {
      font-size: var(--step-2);
    }

    .fold summary::after {
      width: 2rem;
      height: 2rem;
    }
  }

  h3 {
    font-size: var(--step-2);
    margin-bottom: 0.6rem;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 3rem;
  }

  .grid-2 p,
  .process p {
    color: var(--ink-muted);
  }

  .voluntary-lead {
    max-width: 40rem;
    color: var(--ink-muted);
  }

  .voluntary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .voluntary article {
    padding-top: 1.25rem;
    border-top: 1px solid var(--gold);
  }

  .voluntary p {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .scope {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.5rem;
    border-top: 1px solid var(--limestone-200);
  }

  .scope li {
    padding: 0.9rem 0 0.9rem 1.5rem;
    border-bottom: 1px solid var(--limestone-200);
    position: relative;
  }

  .scope li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.45rem;
    width: 0.6rem;
    height: 2px;
    background: var(--gold);
  }

  .scope-note {
    margin-top: 1.5rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Süreç gerçekten sıralı olduğu için numaralı */
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    counter-reset: step;
  }

  .process li {
    counter-increment: step;
    position: relative;
    padding-top: 3.5rem;
    border-top: 2px solid var(--gold);
  }

  .process li::before {
    content: counter(step);
    position: absolute;
    top: 1rem;
    left: 0;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1;
    color: var(--gold);
  }

  .mediator .note {
    margin-top: 1rem;
    color: var(--ink-muted);
  }

  .cta {
    margin-top: 2.5rem;
  }

  /* Arabulucu kartı kendi zemininde; üst boşluğu korunur */
  .section.mediator-band {
    background: var(--limestone-200);
    padding-top: var(--section-y);
  }

  .mediator-band :global(dl) {
    border-top-color: color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .mandatory-lead {
    margin-bottom: 1.25rem;
    color: var(--ink-muted);
    max-width: 36rem;
  }

  .mandatory {
    width: 100%;
    border-collapse: collapse;
  }

  .mandatory tr {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .mandatory tr:first-child {
    border-top: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
  }

  .mandatory th,
  .mandatory td {
    padding: 1.1rem 0;
    text-align: left;
    vertical-align: top;
  }

  .mandatory th {
    font-weight: 450;
    padding-right: 2rem;
  }

  .mandatory th span {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--step--1);
    font-weight: 380;
    color: var(--ink-muted);
  }

  .mandatory td {
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--petrol-700);
  }

  .visually-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 64rem) {
    .voluntary,
    .process {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .grid-2,
    .voluntary,
    .scope {
      grid-template-columns: 1fr;
    }

    /* Dört adım telefonda ikili kalır */
    .process {
      gap: 1.75rem 1.25rem;
    }

    .process li {
      padding-top: 2.75rem;
    }

    .process li::before {
      top: 0.75rem;
    }

    .mandatory tr {
      display: grid;
    }

    .mandatory th {
      padding-bottom: 0.25rem;
    }

    .mandatory td {
      padding-top: 0;
      white-space: normal;
    }
  }
</style>

<script>
  // Bağlantı bir bölümü gösteriyorsa (#surec gibi) o bölüm açık gelir
  function openFromHash() {
    const target = location.hash && document.querySelector<HTMLDetailsElement>(`details${location.hash}`);
    if (target) {
      target.open = true;
      target.scrollIntoView();
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);
</script>
