---
// Arabuluculuk: tam ekran açılış, I–IV numaralı bölümler, Latince ilke bandı,
// zorunlu arabuluculuk tablosu ve dilekçe ile süre hesaplayıcıya giden fotoğraflı bant
import { Image } from 'astro:assets';
import Monogram from '../Monogram.astro';
import { team } from '../../data/office';
import { path, t, type Lang } from '../../i18n/ui';
import { c } from '../../i18n/content';
import { areaLinks } from '../../lib/areas';
import { petitionHref, petitionInfo, petitionsFor } from '../../lib/petitions';
import { petitionImage } from '../../lib/images';
import hero from '../../assets/img/mediation/hero.jpg';
import principlesImg from '../../assets/img/mediation/principles.jpg';
import scopeImg from '../../assets/img/mediation/scope.jpg';
import calcImg from '../../assets/img/mediation/calc.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const k = c(lang);
const m = k.mediation;
const a = k.about;
const mediator = team.find((p) => p.isMediator)!;
const links = await areaLinks(lang);
const petition = (await petitionsFor()).find((p) => p.id === 'ihtiyari-arabuluculuk-basvurusu')!;
const petitionImg = petitionImage(petition.id)!;
---

<section class="m-hero">
  <Image class="m-hero__img" src={hero} alt="" widths={[800, 1400, 2000, 2688]} sizes="100vw" quality={72} loading="eager" />
  <div class="wrap m-hero__inner">
    <p class="kicker">{m.title}</p>
    <h1>{m.heroTitle}</h1>
    <p class="m-hero__lead">{m.lead}</p>
    <div class="m-hero__actions">
      <a class="btn btn--solid" href={path(lang, 'contact')}>{s.cta}</a>
      <a class="btn btn--ghost" href="#surec">{m.processTitle}</a>
    </div>
  </div>
</section>

<section class="section chapter">
  <div class="wrap chapter__head">
    <div>
      <p class="numeral" aria-hidden="true">I</p>
      <h2 class="section-title">{m.principlesTitle}</h2>
      <p class="chapter__lead">{m.voluntaryLead}</p>
    </div>
    <div class="chapter__ph">
      <Image src={principlesImg} alt="" widths={[480, 720, 960]} sizes="(max-width: 50rem) 92vw, 34vw" quality={72} />
    </div>
  </div>
  <div class="wrap">
    <details class="fold" data-fold>
      <summary>{m.principlesTitle}</summary>
      <ul class="principles">
        {
          m.principles.map((pr) => (
            <li>
              <h3>{pr.title}</h3>
              <p>{pr.body}</p>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</section>

<section class="section chapter chapter--reverse">
  <div class="wrap chapter__head">
    <div>
      <p class="numeral" aria-hidden="true">II</p>
      <h2 class="section-title">{m.scopeTitle}</h2>
    </div>
    <div class="chapter__ph">
      <Image src={scopeImg} alt="" widths={[480, 720, 960]} sizes="(max-width: 50rem) 92vw, 34vw" quality={72} />
    </div>
  </div>
  <div class="wrap">
    <details class="fold" data-fold>
      <summary>{m.scopeTitle}</summary>
      <ul class="scope">
        {
          m.scope.map((sc) => (
            <li>
              <a href={links[sc.area] ?? path(lang, 'practice')}>{sc.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="note">{m.scopeNote}</p>
    </details>
  </div>
</section>

<section class="motto">
  <div class="wrap motto__inner">
    <p class="motto__latin" lang="la">{m.motto}</p>
    <p class="motto__meaning">{m.mottoMeaning}</p>
    <p class="motto__note">{m.mottoNote}</p>
  </div>
</section>

<section class="section" id="surec">
  <div class="wrap">
    <p class="numeral" aria-hidden="true">III</p>
    <h2 class="section-title">{m.processTitle}</h2>
    <ol class="timeline" data-timeline>
      <span class="timeline__line" aria-hidden="true" data-timeline-line></span>
      {
        m.process.map((st, i) => (
          <li>
            <span class="timeline__dot" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{st.title}</h3>
            <p>{st.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section mediator">
  <div class="wrap mediator__inner">
    <div class="mediator__frame">
      {
        mediator.photo ? (
          <img src={mediator.photo} alt={mediator.name} width="800" height="800" />
        ) : (
          <Monogram name={mediator.name} />
        )
      }
    </div>
    <div class="mediator__text">
      <p class="numeral" aria-hidden="true">IV</p>
      <h2 class="section-title">{m.mediatorTitle}</h2>
      <p class="mediator__name">Av. Arb. {mediator.name}</p>
      <p class="mediator__role">{mediator.title[lang]} · {m.mediatorNote}</p>
      <dl>
        <div>
          <dt>{a.bar}</dt>
          <dd>{s.footer.bar}</dd>
        </div>
        <div>
          <dt>{a.education}</dt>
          <dd>{mediator.university}</dd>
        </div>
        <div>
          <dt>{a.phone}</dt>
          <dd><a href={`tel:${mediator.phone.replace(/\s/g, '')}`}>{mediator.phone}</a></dd>
        </div>
        {
          mediator.email && (
            <div>
              <dt>{a.email}</dt>
              <dd><a href={`mailto:${mediator.email}`}>{mediator.email}</a></dd>
            </div>
          )
        }
      </dl>
      <div class="mediator__actions">
        <a class="btn btn--solid" href={`${path(lang, 'contact')}?avukat=${encodeURIComponent(mediator.name)}`}>{s.cta}</a>
        <a class="text-link" href={`${path(lang, 'about')}${mediator.slug}/`}>{m.mediatorMore}</a>
      </div>
    </div>
  </div>
</section>

<section class="section mandatory-band">
  <div class="wrap split">
    <div>
      <h2 class="section-title">{m.mandatoryTitle}</h2>
      <p class="mandatory-lead">{m.mandatoryLead}</p>
    </div>
    <table class="mandatory">
      <tbody>
        {
          m.mandatory.map((row) => (
            <tr>
              <th scope="row">
                {row.title}
                <span>{row.basis}</span>
              </th>
              <td>
                <span class="sr-only">{m.durationLabel}: </span>
                {row.duration}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<section class="panels" aria-label={k.resources.title}>
  <a class="panel" href={petitionHref(petition, lang)}>
    <Image src={petitionImg} alt="" widths={[600, 900, 1200]} sizes="(max-width: 50rem) 100vw, 50vw" quality={70} />
    <span class="panel__text">
      <span class="panel__kicker">{m.bandPetition}</span>
      <span class="panel__title">{petitionInfo(petition, lang).title}</span>
    </span>
  </a>
  <a class="panel" href={`${path(lang, 'resources')}#hesapla`}>
    <Image src={calcImg} alt="" widths={[600, 900, 1200]} sizes="(max-width: 50rem) 100vw, 50vw" quality={70} />
    <span class="panel__text">
      <span class="panel__kicker">{m.bandCalc}</span>
      <span class="panel__title">{k.resources.calc.title}</span>
    </span>
  </a>
</section>

<style>
  /* Tam ekran açılış: fotoğraf, solda koyu degrade üzerinde başlık */
  .m-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    background: var(--petrol-900);
    color: var(--silver);
  }

  .m-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  .m-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(12 35 39 / 0.92) 0%, rgb(12 35 39 / 0.55) 45%, rgb(12 35 39 / 0) 75%),
      linear-gradient(180deg, rgb(12 35 39 / 0.7) 0%, rgb(12 35 39 / 0) 30%, rgb(12 35 39 / 0) 70%, rgb(12 35 39 / 0.6) 100%);
  }

  .m-hero__inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--header-h) + 3rem);
    padding-bottom: clamp(3rem, 9vh, 6rem);
  }

  .kicker {
    font-size: var(--step--1);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  h1 {
    margin-top: 1.25rem;
    white-space: pre-line;
    font-size: clamp(2.25rem, 5vw, 4.5rem);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: #f3f3f2;
  }

  .m-hero__lead {
    max-width: 34rem;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--gold);
    font-size: var(--step-1);
    font-weight: 330;
  }

  .m-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  /* Bölüm numarası */
  .numeral {
    margin-bottom: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 5.5rem);
    font-weight: 400;
    line-height: 1;
    color: var(--gold);
  }

  .chapter__head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .chapter--reverse .chapter__ph {
    order: -1;
  }

  .chapter--reverse .chapter__head {
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
  }

  .chapter__ph img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .chapter__lead {
    max-width: 34rem;
    font-size: var(--step-1);
    font-weight: 330;
    color: var(--ink-muted);
  }

  /* Bilgisayarda açık; telefonda başlığa dokununca açılır */
  .fold > summary {
    display: none;
  }

  .principles {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2.5rem;
  }

  .principles li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gold);
  }

  .principles h3 {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .principles p {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .scope {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 3rem;
  }

  .scope a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--limestone-200);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.3;
    transition: color 0.25s;
  }

  .scope a::after {
    content: '→';
    flex: none;
    font-family: var(--font-sans);
    color: var(--gold);
    transition: transform 0.25s;
  }

  .scope a:hover {
    color: var(--petrol-700);
  }

  .scope a:hover::after {
    transform: translateX(4px);
  }

  .note {
    margin-top: 1.5rem;
    max-width: 60ch;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Latince ilke bandı */
  .motto {
    padding-block: clamp(4rem, 10vw, 8rem);
    background:
      radial-gradient(ellipse 50% 80% at 50% 0%, var(--petrol-700) 0%, transparent 70%),
      var(--petrol-900);
    color: var(--silver);
    text-align: center;
  }

  .motto__inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
  }

  .motto__latin {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 5rem);
    font-weight: 450;
    letter-spacing: 0.08em;
    line-height: 1.05;
    text-transform: uppercase;
    color: #f3f3f2;
  }

  .motto__meaning {
    padding-top: 1rem;
    border-top: 1px solid var(--gold);
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-style: italic;
    color: var(--gold-soft);
  }

  .motto__note {
    max-width: 40ch;
    font-size: var(--step--1);
    color: var(--silver-muted);
  }

  /* Süreç: altın çizgi üzerinde dört adım */
  #surec {
    scroll-margin-top: 1rem;
  }

  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .timeline__line {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    right: 0;
    height: 1px;
    background: var(--gold);
    transform-origin: left center;
  }

  .timeline li {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .timeline__dot {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.75rem;
    border: 1px solid var(--gold);
    border-radius: 50%;
    background: var(--limestone);
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: var(--petrol-800);
  }

  .timeline h3 {
    font-size: var(--step-2);
  }

  .timeline p {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* Arabulucu: solda büyük kare çerçeve */
  .section.mediator {
    padding-top: var(--section-y);
    background: #f7f7f4;
    border-block: 1px solid var(--limestone-200);
  }

  .mediator__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .mediator__frame {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background:
      radial-gradient(ellipse 70% 70% at 50% 40%, var(--petrol-700) 0%, transparent 75%),
      var(--petrol-800);
    border: 1px solid var(--gold);
  }

  .mediator__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mediator__frame :global(.monogram) {
    width: 42%;
  }

  .mediator__frame :global(.monogram span) {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
  }

  .mediator__name {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1.1;
  }

  .mediator__role {
    margin-top: 0.5rem;
    color: var(--petrol-700);
  }

  .mediator dl {
    margin: 1.75rem 0 0;
    display: grid;
    gap: 0;
  }

  .mediator dl > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--limestone-200);
  }

  .mediator dt {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .mediator dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .mediator dd a {
    color: inherit;
    text-decoration-color: var(--gold);
    text-underline-offset: 3px;
  }

  .mediator__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }

  .mediator__actions .text-link {
    margin-top: 0;
  }

  /* Zorunlu arabuluculuk tablosu */
  .section.mandatory-band {
    padding-top: var(--section-y);
  }

  .mandatory-lead {
    max-width: 30rem;
    margin-top: 1rem;
    color: var(--ink-muted);
  }

  .mandatory {
    width: 100%;
    border-collapse: collapse;
  }

  .mandatory tr {
    border-top: 1px solid var(--gold);
  }

  .mandatory tr:last-child {
    border-bottom: 1px solid var(--gold);
  }

  .mandatory th,
  .mandatory td {
    padding: 1.25rem 0;
    vertical-align: top;
    text-align: left;
  }

  .mandatory th {
    font-weight: 450;
  }

  .mandatory th span {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 380;
    color: var(--ink-muted);
  }

  .mandatory td {
    padding-left: 2rem;
    text-align: right;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--petrol-800);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Fotoğraflı kapanış bandı */
  .panels {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .panel {
    position: relative;
    display: block;
    min-height: clamp(18rem, 42vw, 30rem);
    overflow: hidden;
    color: #f3f3f2;
    text-decoration: none;
  }

  .panel :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(12 35 39 / 0.85) 0%, rgb(12 35 39 / 0.2) 60%, rgb(12 35 39 / 0.1) 100%);
  }

  .panel__text {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: grid;
    gap: 0.4rem;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .panel__kicker {
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  .panel__title {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1.1;
  }

  .panel__title::after {
    content: ' →';
    font-family: var(--font-sans);
    font-size: 0.6em;
    color: var(--gold);
  }

  @media (hover: hover) and (pointer: fine) {
    .panel:hover :global(img) {
      transform: scale(1.04);
    }
  }

  @media (max-width: 64rem) {
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 50rem) {
    .chapter__head,
    .chapter--reverse .chapter__head,
    .mediator__inner {
      grid-template-columns: 1fr;
    }

    .chapter__ph,
    .chapter--reverse .chapter__ph {
      order: -1;
    }

    .chapter__ph img {
      aspect-ratio: 3 / 2;
    }

    .scope {
      grid-template-columns: 1fr;
    }

    /* Süreç dikey: çizgi solda */
    .timeline {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding-left: 4rem;
    }

    .timeline__line {
      top: 0;
      bottom: 0;
      left: 1.5rem;
      right: auto;
      width: 1px;
      height: auto;
      transform-origin: center top;
    }

    .timeline__dot {
      position: absolute;
      left: -4rem;
      top: -0.5rem;
    }

    .mediator__frame {
      max-width: 22rem;
    }

    .panels {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .m-hero {
      min-height: 72svh;
    }

    /* Telefonda derli toplu: alçak yatay fotoğraflar, küçük numaralar ve çerçeve */
    .numeral {
      margin-bottom: 0.25rem;
      font-size: 2.5rem;
    }

    .chapter__head {
      gap: 1.25rem;
      margin-bottom: 1rem;
    }

    .chapter__ph img {
      aspect-ratio: 16 / 9;
    }

    .chapter__lead {
      font-size: var(--step-0);
    }

    .motto {
      padding-block: 3rem;
    }

    .timeline {
      gap: 1.1rem;
    }

    .mediator__inner {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 1.25rem;
      align-items: start;
    }

    .mediator__frame {
      max-width: none;
    }

    .mediator__frame :global(.monogram span) {
      font-size: 1.75rem;
    }

    .mediator__text .numeral,
    .mediator__text .section-title {
      display: none;
    }

    .mediator__name {
      font-size: 1.5rem;
    }


    .panel {
      min-height: 11rem;
    }

    .panel__title {
      font-size: 1.5rem;
    }

    .m-hero::after {
      background: linear-gradient(180deg, rgb(12 35 39 / 0.75) 0%, rgb(12 35 39 / 0.45) 40%, rgb(12 35 39 / 0.92) 100%);
    }

    /* Telefonda I ve II başlığa dokununca açılır */
    .fold > summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem 0;
      border-top: 1px solid var(--gold);
      border-bottom: 1px solid var(--limestone-200);
      cursor: pointer;
      list-style: none;
      font-size: var(--step--1);
      letter-spacing: 0.04em;
      color: var(--petrol-700);
    }

    .fold > summary::-webkit-details-marker {
      display: none;
    }

    .fold > summary::after {
      content: '+';
      color: var(--gold);
      font-size: 1.25rem;
      transition: transform 0.25s;
    }

    .fold[open] > summary::after {
      transform: rotate(45deg);
    }

    .fold[open] > summary {
      margin-bottom: 1.25rem;
    }

    .principles {
      gap: 1.25rem 0.875rem;
    }

    .principles h3 {
      font-size: 1.125rem;
      overflow-wrap: break-word;
    }

    .principles p {
      font-size: 0.8125rem;
    }

    .mediator dl > div {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .mandatory th,
    .mandatory td {
      display: block;
      padding: 0;
      text-align: left;
    }

    .mandatory tr {
      display: block;
      padding: 1rem 0;
    }

    .mandatory td {
      margin-top: 0.4rem;
      white-space: normal;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Bilgisayarda I ve II açık başlar; telefonda kapalıdır, bağlantı bir bölümü gösteriyorsa açılır
  const wide = window.matchMedia('(min-width: 40.0625rem)');
  const folds = document.querySelectorAll<HTMLDetailsElement>('[data-fold]');
  const syncFolds = () => folds.forEach((d) => (d.open = wide.matches));
  syncFolds();
  wide.addEventListener('change', syncFolds);

  // Süreç çizgisi kaydırdıkça çizilir; hareket azaltma tercihinde baştan tam görünür
  const line = document.querySelector<HTMLElement>('[data-timeline-line]');
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (line && timeline && !still) {
    gsap.registerPlugin(ScrollTrigger);
    const vertical = window.matchMedia('(max-width: 50rem)').matches;
    gsap.fromTo(
      line,
      { [vertical ? 'scaleY' : 'scaleX']: 0 },
      {
        [vertical ? 'scaleY' : 'scaleX']: 1,
        ease: 'none',
        scrollTrigger: { trigger: timeline, start: 'top 80%', end: 'bottom 60%', scrub: 0.6 },
      },
    );
  }
</script>
