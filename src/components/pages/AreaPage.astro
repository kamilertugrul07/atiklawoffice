---
// Tek bir faaliyet alanının sayfası: başlık ve fotoğraf, giriş, hizmetler, süreç, sorular, diğer alanlar
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { path, t, type Lang } from '../../i18n/ui';
import { c } from '../../i18n/content';
import { areaEntryLang, areaHref, areaImage, type AreaEntry } from '../../lib/areas';
import { petitionsFor } from '../../lib/petitions';
import PetitionList from '../PetitionList.astro';

interface Props {
  lang: Lang;
  entry: AreaEntry;
}
const { lang, entry } = Astro.props;
const s = t(lang);
const p = c(lang).practice;
const g = p.page;
const area = p.areas.find((a) => a.id === entry.data.key)!;
const image = areaImage(area.id);
const { Content } = await render(entry);
const steps = entry.data.process ?? g.steps;
const contact = `${path(lang, 'contact')}?konu=${area.id}`;
const petitions = await petitionsFor(area.id);
const r = c(lang).resources;

// Diğer alanlar: sayfası olanlar bağlantılı, olmayanlar faaliyet alanları sayfasına gider
const pages = await getCollection('areas', (e) => areaEntryLang(e) === lang);
const others = p.areas
  .filter((a) => a.id !== area.id)
  .map((a) => {
    const page = pages.find((e) => e.data.key === a.id);
    return { title: a.title, href: page ? areaHref(page) : path(lang, 'practice') };
  });

const faqLd = entry.data.faqs.length > 0 && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

{faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}

<section class="head">
  <div class="wrap head__inner">
    <div class="head__text">
      <nav class="crumbs" aria-label={g.crumb}>
        <a href={path(lang, 'practice')}>{g.crumb}</a>
        <span aria-hidden="true">/</span>
      </nav>
      <h1>{area.title}</h1>
      <p class="lead">{area.summary}</p>
      <a class="btn btn--solid" href={contact}>{s.cta}</a>
    </div>
    {
      image && (
        <div class="head__ph">
          <Image
            src={image}
            alt={entry.data.imageAlt}
            widths={[480, 720, 960]}
            sizes="(max-width: 50rem) 92vw, 34vw"
            quality={74}
            loading="eager"
          />
        </div>
      )
    }
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div class="prose">
      <Content />
    </div>
    <aside class="facts">
      <h2>{g.factsTitle}</h2>
      <dl>
        {
          area.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="note">{p.note}</p>
    </aside>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="section-title">{g.servicesTitle}</h2>
    <ul class="services">
      {
        entry.data.services.map((sv) => (
          <li>
            <h3>{sv.title}</h3>
            <p>{sv.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section section--dark">
  <div class="wrap">
    <h2 class="section-title">{g.processTitle}</h2>
    <ol class="steps">
      {
        steps.map((st) => (
          <li>
            <h3>{st.title}</h3>
            <p>{st.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

{
  entry.data.faqs.length > 0 && (
    <section class="section">
      <div class="wrap split">
        <h2 class="section-title">{g.faqTitle}</h2>
        <div class="faq">
          {entry.data.faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  petitions.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="section-title">{r.areaTitle}</h2>
        <PetitionList lang={lang} petitions={petitions} />
      </div>
    </section>
  )
}

<section class="section ask">
  <div class="wrap ask__inner">
    <div>
      <h2>{g.askTitle}</h2>
      <p>{g.askLead}</p>
    </div>
    <a class="btn btn--solid" href={contact}>{s.cta}</a>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <h2 class="section-title">{g.othersTitle}</h2>
    <ul class="others">
      {
        others.map((o) => (
          <li>
            <a href={o.href}>{o.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Üst bant: PageHead ile aynı zemin, header bunun üzerinde durur */
  .head {
    background:
      radial-gradient(ellipse 60% 90% at 85% 0%, var(--petrol-700) 0%, transparent 70%),
      var(--petrol-800);
    color: var(--silver);
    padding-top: calc(var(--header-h) + clamp(2rem, 6vw, 4.5rem));
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .head__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: var(--step--1);
    letter-spacing: 0.03em;
    color: var(--silver-muted);
  }

  .crumbs a {
    color: var(--gold-soft);
    text-decoration: none;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  h1 {
    max-width: 16ch;
    font-size: var(--step-4);
    font-weight: 450;
    line-height: 1;
    letter-spacing: -0.015em;
    color: #f3f3f2;
  }

  .lead {
    max-width: 36rem;
    margin: 1.75rem 0 2.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--gold);
    font-size: var(--step-1);
    font-weight: 330;
  }

  .head__ph img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .prose {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
    font-size: var(--step-1);
    font-weight: 330;
    line-height: 1.6;
  }

  .prose :global(p) {
    margin: 0;
  }

  .facts {
    padding: 1.75rem;
    background: #f7f7f4;
    border-top: 2px solid var(--gold);
  }

  .facts h2 {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
  }

  .facts dl {
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .facts dt {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .facts dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 550;
    color: var(--petrol-800);
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .services {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .services li {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 1.5rem 1.6rem;
    background: #f7f7f4;
    border: 1px solid var(--limestone-200);
  }

  .services h3 {
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .services p {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    counter-reset: step;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--gold);
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--gold);
  }

  .steps h3 {
    font-size: var(--step-2);
    color: #f3f3f2;
  }

  .steps p {
    font-size: var(--step--1);
    color: var(--silver-muted);
  }

  .faq {
    display: grid;
    gap: 0.6rem;
  }

  .faq details {
    background: #f7f7f4;
    border: 1px solid var(--limestone-200);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.1rem 1.4rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 550;
    line-height: 1.3;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    flex: none;
    font-family: var(--font-sans);
    font-weight: 300;
    color: var(--gold);
    transition: transform 0.25s;
  }

  .faq details[open] summary::after {
    transform: rotate(45deg);
  }

  .faq details p {
    padding: 0 1.4rem 1.25rem;
    color: var(--ink-muted);
  }

  /* Kendi zemini olduğu için üst boşluğu korunur */
  .section.ask {
    background: var(--limestone-200);
    padding-top: var(--section-y);
  }

  /* Gri bandın ardından gelen bölüm kendi üst boşluğunu korur */
  .section.ask + .section {
    padding-top: var(--section-y);
  }

  .ask__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1.5rem 3rem;
  }

  .ask h2 {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }

  .ask p {
    max-width: 40rem;
    color: var(--ink-muted);
  }

  .others {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .others a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 0.75rem 1.4rem;
    background: #f7f7f4;
    border: 1px solid var(--limestone-200);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.2;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .others a::after {
    content: '→';
    flex: none;
    font-family: var(--font-sans);
    color: var(--gold);
  }

  .others a:hover {
    background: var(--petrol-800);
    color: #f3f3f2;
  }

  @media (max-width: 64rem) {
    .services,
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 50rem) {
    .head__inner {
      grid-template-columns: 1fr;
    }

    .head__ph {
      order: -1;
    }

    .head__ph img {
      aspect-ratio: 3 / 2;
    }

    /* Gri bandın ardından gelen bölüm kendi üst boşluğunu korur */
  .section.ask + .section {
    padding-top: var(--section-y);
  }

  .ask__inner {
      grid-template-columns: 1fr;
      justify-items: start;
    }
  }

  @media (max-width: 40rem) {
    .services {
      grid-template-columns: 1fr;
    }

    /* Telefonda diğer alanlar ikili kalır, liste kısa görünür */
    .others a {
      min-height: 3.25rem;
      padding: 0.6rem 0.8rem;
      font-size: 0.9375rem;
    }

    .others a::after {
      display: none;
    }

    .steps {
      gap: 1.5rem 1rem;
    }

    .services li {
      padding: 1.25rem;
    }

    .faq summary {
      padding: 1rem 1.1rem;
    }

    .faq details p {
      padding: 0 1.1rem 1rem;
    }
  }
</style>
