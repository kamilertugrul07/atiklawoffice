---
import Logo from './Logo.astro';
import { langs, languages, navKeys, path, t, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  // Dil değiştiricide aynı sayfanın diğer dildeki karşılığına gitmek için
  routeKey?: RouteKey;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, routeKey, alternates } = Astro.props;
const s = t(lang);
const isHome = Astro.url.pathname.replace(/\/$/, '') === path(lang).replace(/\/$/, '');
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={path(lang)} aria-label={s.firmName}>
      <Logo lang={lang} label={s.firmName} />
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="menu-toggle__label" data-open-label={s.menu} data-close-label={s.close}>{s.menu}</span>
      <span class="menu-toggle__icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label={s.menu} data-nav>
      <ul class="nav__links">
        <li>
          <a class="home-link" href={path(lang)} aria-current={isHome ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.5 10.5 12 3.5l8.5 7M5.5 9v11h5v-6h3v6h5V9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
            </svg>
            <span class="home-link__label">{s.nav.home}</span>
          </a>
        </li>
        {
          navKeys.map((key) => (
            <li>
              <a href={path(lang, key)} aria-current={routeKey === key ? 'page' : undefined}>
                {s.nav[key]}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="lang-switch" aria-label="Language">
        {
          langs.map((l) => (
            <li>
              <a
                href={alternates[l] ?? path(l, routeKey)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
              >
                {languages[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    inset: 0 0 auto;
    z-index: 20;
    color: var(--silver);
    --logo-ink: #ecedee;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: var(--header-h);
    padding-block: 1rem;
  }

  .brand {
    flex: none;
    width: clamp(11rem, 23vw, 21rem);
  }

  /* Dar masaüstünde menü sığsın diye logo biraz küçülür */
  @media (max-width: 76rem) {
    .brand {
      width: 18vw;
    }
  }

  /* Ev simgesi; yazısı yalnız mobil menüde görünür, masaüstünde ekran okuyucular için kalır */
  .home-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .home-link svg {
    display: block;
    width: 1.375rem;
    height: 1.375rem;
    color: var(--gold);
  }

  .home-link__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2.5rem;
  }

  .nav ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Simge ve yazılar aynı çizgide ortalanır */
  .nav__links {
    align-items: center;
    gap: 2rem;
  }

  .nav__links li {
    display: flex;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
  }

  .nav a {
    white-space: nowrap;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--silver-muted);
    transition: color 0.2s;
  }

  .nav a:hover,
  .nav a[aria-current] {
    color: #fff;
  }

  .lang-switch {
    gap: 0.25rem;
    padding-left: 2rem;
    border-left: 1px solid var(--petrol-700);
  }

  .lang-switch a {
    padding: 0.25rem 0.4rem;
  }

  .lang-switch a[aria-current] {
    color: var(--gold);
  }

  .menu-toggle {
    display: none;
  }

  /* Menü yan yana sığmadığında açılır menüye geçilir */
  @media (max-width: 68rem) {
    .menu-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      min-height: 2.75rem;
      padding: 0 0.25rem;
      background: none;
      border: 0;
      color: var(--silver);
      font: inherit;
      font-size: var(--step--1);
      cursor: pointer;
      position: relative;
      z-index: 2;
    }

    .menu-toggle__icon {
      width: 1.5rem;
      height: 7px;
      border-block: 1px solid var(--gold);
    }

    .nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 3rem;
      padding: var(--gutter);
      background: var(--petrol-900);
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.3s, visibility 0.3s;
    }

    .nav.is-open {
      visibility: visible;
      opacity: 1;
    }

    .nav__links {
      flex-direction: column;
      gap: 1.25rem;
    }

    .nav__links a {
      font-family: var(--font-serif);
      font-size: var(--step-3);
      color: var(--silver);
    }

    .lang-switch {
      padding-left: 0;
      border-left: 0;
    }

    .home-link__label {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
    }

    .home-link svg {
      width: 1.5rem;
      height: 1.5rem;
    }

    .brand {
      width: clamp(9.5rem, 30vw, 11.5rem);
    }

    .lang-switch a {
      font-size: var(--step-0);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = toggle?.querySelector<HTMLElement>('.menu-toggle__label');

  function setOpen(open: boolean) {
    if (!toggle || !nav || !label) return;
    toggle.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    label.textContent = open ? label.dataset.closeLabel! : label.dataset.openLabel!;
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
