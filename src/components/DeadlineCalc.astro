---
// Süre hesaplayıcı: işlem ve başlangıç tarihi seçilir, son gün büyük yazılır
import { deadlines } from '../data/deadlines';
import type { Lang } from '../i18n/ui';
import { c } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const k = c(lang).resources.calc;
const locales: Record<Lang, string> = { tr: 'tr-TR', en: 'en-GB', ru: 'ru-RU' };
---

<div
  class="calc"
  data-calc
  data-locale={locales[lang]}
  data-line={k.line}
  data-passed={k.passed}
  data-today={k.today}
  data-few={k.fewDays}
  data-left={k.daysLeft}
>
  <form class="calc__pick" onsubmit="return false">
    <h2>{k.title}</h2>
    <p>{k.lead}</p>
    <label>
      <span>{k.act}</span>
      <select data-calc-act>
        {
          deadlines.map((d) => (
            <option data-n={d.n} data-unit={d.unit} data-law={d.law}>
              {d.label[lang]}
            </option>
          ))
        }
      </select>
    </label>
    <label>
      <span>{k.date}</span>
      <input type="date" required data-calc-date />
    </label>
  </form>
  <div class="calc__out" aria-live="polite">
    <p class="calc__label">{k.result}</p>
    <p class="calc__big" data-calc-big>—</p>
    <p class="calc__wd" data-calc-wd>{k.empty}</p>
    <p class="calc__left" data-calc-left hidden></p>
    <p class="calc__note">{k.note}</p>
  </div>
</div>

<style>
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .calc__pick {
    display: grid;
    align-content: start;
    gap: 1.1rem;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    background: #f7f7f4;
    border: 1px solid var(--limestone-200);
  }

  .calc__pick h2 {
    font-size: var(--step-3);
  }

  .calc__pick > p {
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }

  label {
    display: grid;
    gap: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  select,
  input {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--limestone-200);
    border-bottom-color: var(--ink-muted);
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: inherit;
    /* 16px altında iPhone, alana dokununca sayfayı yakınlaştırır */
    font-size: max(1rem, var(--step-0));
  }

  .calc__out {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    background: var(--petrol-800);
    color: var(--silver);
  }

  .calc__label {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  .calc__big {
    margin: 0.4rem 0 0.5rem;
    font-family: var(--font-serif);
    font-size: var(--step-4);
    font-weight: 450;
    line-height: 1.05;
    color: #f3f3f2;
  }

  .calc__wd {
    color: var(--silver-muted);
  }

  .calc__left {
    align-self: flex-start;
    margin-top: 1.25rem;
    padding: 0.75rem 1rem;
    background: #fdecea;
    border-left: 4px solid #b3261e;
    color: #8c1d16;
    font-weight: 500;
  }

  .calc__left.is-calm {
    background: color-mix(in srgb, var(--gold) 18%, transparent);
    border-left-color: var(--gold);
    color: #f3f3f2;
  }

  .calc__note {
    margin-top: 1.75rem;
    max-width: 46ch;
    font-size: 0.8125rem;
    color: var(--silver-muted);
  }

  @media (max-width: 50rem) {
    .calc {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Son gün: başlangıç tarihine süre eklenir; hafta sonuna düşerse sonraki iş gününe kayar.
  // İş günü cinsinden sürelerde hafta sonları hiç sayılmaz.
  const isWeekend = (d: Date) => d.getDay() === 0 || d.getDay() === 6;
  const addDays = (d: Date, n: number) => new Date(d.getFullYear(), d.getMonth(), d.getDate() + n);
  const addMonths = (d: Date, n: number) => {
    const r = new Date(d.getFullYear(), d.getMonth() + n, 1);
    r.setDate(Math.min(d.getDate(), new Date(r.getFullYear(), r.getMonth() + 1, 0).getDate()));
    return r;
  };

  function lastDay(from: Date, n: number, unit: string) {
    let d: Date;
    if (unit === 'i') {
      d = from;
      for (let left = n; left > 0; ) {
        d = addDays(d, 1);
        if (!isWeekend(d)) left--;
      }
    } else {
      d = unit === 'a' ? addMonths(from, n) : addDays(from, n * (unit === 'h' ? 7 : 1));
    }
    while (isWeekend(d)) d = addDays(d, 1);
    return d;
  }

  document.querySelectorAll<HTMLElement>('[data-calc]').forEach((root) => {
    const act = root.querySelector<HTMLSelectElement>('[data-calc-act]')!;
    const date = root.querySelector<HTMLInputElement>('[data-calc-date]')!;
    const big = root.querySelector<HTMLElement>('[data-calc-big]')!;
    const wd = root.querySelector<HTMLElement>('[data-calc-wd]')!;
    const left = root.querySelector<HTMLElement>('[data-calc-left]')!;
    const t = root.dataset;
    const fmt = new Intl.DateTimeFormat(t.locale, { day: 'numeric', month: 'long', year: 'numeric' });
    const weekday = new Intl.DateTimeFormat(t.locale, { weekday: 'long' });

    const render = () => {
      const opt = act.selectedOptions[0];
      if (!date.value || !opt) return;
      const [y, m, d] = date.value.split('-').map(Number);
      const end = lastDay(new Date(y, m - 1, d), Number(opt.dataset.n), opt.dataset.unit ?? 'g');
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const days = Math.round((end.getTime() - today.getTime()) / 864e5);
      big.textContent = fmt.format(end);
      const day = weekday.format(end);
      wd.textContent = `${t.line!.replace('{day}', day[0].toUpperCase() + day.slice(1)).replace('{act}', opt.textContent?.trim() ?? '')} (${opt.dataset.law})`;
      left.hidden = false;
      left.textContent =
        days < 0
          ? t.passed!
          : days === 0
            ? t.today!
            : (days <= 3 ? t.few! : t.left!).replace('{n}', String(days));
      left.classList.toggle('is-calm', days > 3);
    };

    act.addEventListener('input', render);
    date.addEventListener('input', render);
    // Bugünden başlar; sonuç alanı hiç boş kalmaz
    const now = new Date();
    date.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    render();
  });
</script>
