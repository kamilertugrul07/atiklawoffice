---
// Ayrıntı penceresi. Açmak için: <button data-open="{id}">
// İçerik stilleri global.css içindeki .sheet__* sınıflarında.
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  closeLabel: string;
}
const { id, title, subtitle, closeLabel } = Astro.props;
---

<dialog class="sheet" id={id} aria-labelledby={`${id}-title`}>
  <header>
    <div>
      <h2 id={`${id}-title`}>{title}</h2>
      {subtitle && <p>{subtitle}</p>}
    </div>
    <button class="sheet__close" type="button" data-close aria-label={closeLabel}>
      <span aria-hidden="true"></span>
    </button>
  </header>
  <div class="sheet__body">
    <slot />
  </div>
</dialog>

<style>
  .sheet {
    width: min(42rem, calc(100vw - 2rem));
    max-height: calc(100svh - 2rem);
    padding: 0;
    border: 0;
    background: var(--limestone);
    color: var(--ink);
    box-shadow: 0 30px 80px rgb(12 35 39 / 0.45);
  }

  .sheet::backdrop {
    background: rgb(12 35 39 / 0.7);
  }

  .sheet[open] {
    animation: sheet-in 0.3s ease-out;
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 2rem 2rem 1.5rem;
    background: var(--petrol-800);
    color: #f3f3f2;
    border-bottom: 2px solid var(--gold);
  }

  h2 {
    font-size: var(--step-3);
    line-height: 1.05;
  }

  header p {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--silver);
  }

  .sheet__close {
    flex: none;
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid color-mix(in srgb, var(--silver) 40%, transparent);
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .sheet__close span::before,
  .sheet__close span::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1rem;
    height: 1px;
    background: var(--silver);
    translate: -50% -50%;
    rotate: 45deg;
  }

  .sheet__close span::after {
    rotate: -45deg;
  }

  .sheet__close:hover {
    border-color: var(--gold);
  }

  .sheet__body {
    padding: 1.75rem 2rem 2rem;
  }

  @media (max-width: 40rem) {
    header,
    .sheet__body {
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet[open] {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = 'true';
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Pencerenin dışına tıklanınca kapanır
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
